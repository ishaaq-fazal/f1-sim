# Copy to .env (which is gitignored) and adjust.
APP_ENV=dev                      # anything other than "dev" hides /docs
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
HTTP_RATE_PER_MIN=120
WS_MSGS_PER_SEC=10
WS_MAX_PER_IP=3
# Database file lives in data/ (gitignored, outside the web root)
DATABASE_URL=sqlite:///data/f1sim.db
# Required outside dev (in dev, one is generated into data/.secret_key if empty). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
DEFAULT_ROLE=principal           # role for new sign-ups: viewer or principal (first user becomes admin)
LOGIN_ATTEMPTS_PER_MIN=5
